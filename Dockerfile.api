# The API only, for Render. The React app is hosted on Vercel, which forwards /api to this service
# (see frontend/vercel.json), so the browser still sees one origin and the refresh cookie keeps working.
# The full image (API + built frontend on one origin) is the Dockerfile, used by docker-compose and CI.

FROM python:3.15-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    PORT=4000 \
    FORWARDED_ALLOW_IPS=127.0.0.1
WORKDIR /app/backend
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app app
COPY backend/scripts scripts
RUN useradd --system --no-create-home app
USER app
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import urllib.request,os; urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"PORT\"]}/api/health')"
# --proxy-headers: behind Vercel and Render's proxy (FORWARDED_ALLOW_IPS='*' on Render) rate limits see the visitor's IP.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers"]
